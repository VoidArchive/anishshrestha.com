{
	"name": "anishshrestha.com",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"build": "vite build",
		"deploy": "wrangler deploy --config wrangler.toml",
		"deploy:production": "pnpm run build && pnpm run check && pnpm run lint && wrangler deploy --config wrangler.toml --env production",
		"validate": "pnpm run check && pnpm run lint && pnpm run build",
		"ci": "pnpm run validate",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.12",
		"vitest": "^5.1.0",
		"wrangler": "^4.156.2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.66.0",
		"prism-themes": "^1.9.0"
	},
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#core/*": "./src/core/*",
		"#labs/*": "./src/labs/*"
	},
	"packageManager": "pnpm@12.16.1"
}
